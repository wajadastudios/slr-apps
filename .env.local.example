# Copy this file to .env.local and fill in real values from your Supabase project
# (Supabase dashboard -> Project Settings -> API)

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only, never expose to the browser. Used for admin-level operations
# (e.g. creating users). Keep this out of any NEXT_PUBLIC_ variable.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Server-only. Bearer token the daily Supabase health-check endpoint
# (GET /api/health/supabase) requires. Generate a long random value, e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Never put it in a NEXT_PUBLIC_ variable. Set the same value as the GitHub
# secret SLR_HEALTHCHECK_SECRET.
SLR_HEALTHCHECK_SECRET=
