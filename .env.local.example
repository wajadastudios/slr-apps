# Copy this file to .env.local and fill in real values from your Supabase project
# (Supabase dashboard -> Project Settings -> API)

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only, never expose to the browser. Used for admin-level operations
# (e.g. creating users). Keep this out of any NEXT_PUBLIC_ variable.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
